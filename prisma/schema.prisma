// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Performance: Enable preview features for better performance
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Security: Define role enum for better type safety
enum UserRole {
  USER
  ADMIN
  EDITOR
  MODERATOR
  SUPERADMIN
  SYSTEM
}

enum ProductCategory {
  HONEY
  SAFFRON
  DATES
  OTHERS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Performance: Product model with optimized fields
model Product {
  id          String         @id @default(uuid())
  name        String         @db.VarChar(255)
  category    ProductCategory
  description String?
  price       Float          @default(0.0)
  quantity    Int            @default(0)
  status      ProductStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      Image[]
  cartItems   CartItem[]
  
  // Performance: Add indexes for common queries
  @@index([category])
  @@index([price])
  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@index([category, status])
  @@index([price, status])
}

// Security: Image model with validation
model Image {
  id        String   @id @default(uuid())
  image     String   @db.VarChar(500) // Limit URL length
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  // Performance: Add index for product queries
  @@index([productId])
}

// Security: Cart item model with validation
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes
  @@index([userId])
  @@index([productId])
  @@index([userId, productId])
  @@index([createdAt])
}

// Security: Enhanced User model with better validation
model User {
  id                             String    @id @default(cuid())
  email                          String    @unique @db.VarChar(255)
  username                       String?   @db.VarChar(100) // Display name for better UX
  firstName                      String?   @db.VarChar(100)
  lastName                       String?   @db.VarChar(100)
  gender                         Gender?   // For personalized UI
  profilePicture                 String?   @db.VarChar(500) // URL to profile image
  password                       String    @db.VarChar(255)
  emailVerified                  Boolean   @default(false)
  emailVerificationToken         String?   @unique @db.VarChar(255)
  emailVerificationTokenExpires  DateTime?
  twoFactorEnabled               Boolean   @default(false)
  twoFactorSecret                String?   @db.VarChar(255)
  refreshToken                   String?   @unique @db.VarChar(255)
  passwordResetToken             String?   @unique @db.VarChar(255)
  passwordResetTokenExpires      DateTime?
  role                           UserRole  @default(USER)
  canLogin                       Boolean   @default(true)
  disabled                       Boolean   @default(false)
  lastLoginAt                    DateTime?
  loginAttempts                  Int       @default(0)
  lockedUntil                    DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  
  // Relations
  sessions       Session[]
  auditLogs      AuditLog[]
  recoveryCodes  RecoveryCode[]
  articles       Article[]
  
  // Performance: Add indexes for common queries
  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

// Security: Recovery codes model
model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(255)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes
  @@index([userId])
  @@index([createdAt])
}

// Security: Session model with better tracking
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique @db.VarChar(255)
  userAgent    String?  @db.VarChar(500)
  ip           String?  @db.VarChar(45) // IPv6 compatible
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
}

// Security: Audit log model with better structure
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Performance: Add indexes for common queries
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
}

// Security: Article model with proper validation and relations
model Article {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  imageUrl  String?  @db.VarChar(500)
  summary   String   @db.VarChar(500)
  content   String   @db.Text
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes for common queries
  @@index([slug])
  @@index([authorId])
  @@index([createdAt])
  @@index([title])
  @@index([status])
}