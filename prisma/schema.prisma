// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Performance: Enable preview features for better performance
  previewFeatures = ["postgresqlExtensions"]
}



datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Security: Define role enum for better type safety
enum UserRole {
  USER
  ADMIN
  EDITOR
  MODERATOR
  SUPERADMIN
  SYSTEM
}

enum ProductCategory {
  HONEY
  SAFFRON
  DATES
  OTHERS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Performance: Product model with optimized fields and dynamic pricing support
model Product {
  id          String         @id @default(uuid())
  name        String         @unique @db.VarChar(255)
  category    ProductCategory
  description String?
  basePrice   Float          @default(0.0) // Base price for 1 unit
  baseUnitId  String         // Reference to base unit
  quantity    Int            @default(0)
  status      ProductStatus  @default(ACTIVE)
  isNew       Boolean        @default(false) // New product badge
  isBestSeller Boolean       @default(false) // Best seller badge
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  // Relations
  images      Image[]
  cartItems   CartItem[]
  discounts   Discount[]
  baseUnit    Unit           @relation(fields: [baseUnitId], references: [id])
  
  // Performance: Add indexes for common queries
  @@index([category])
  @@index([basePrice])
  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@index([category, status])
  @@index([basePrice, status])
  @@index([isNew])
  @@index([isBestSeller])
}

// Unit model for dynamic pricing
model Unit {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(50) // e.g., "gram", "kilogram", "liter", "package"
  symbol      String   @unique @db.VarChar(10) // e.g., "g", "kg", "L", "pkg"
  multiplier  Float    @default(1.0) // Multiplier for base price calculation
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  products    Product[] // Products that use this as base unit
  cartItems   CartItem[] // Cart items using this unit
  
  // Performance: Add indexes
  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

// Discount model for Amazon-style discounts
model Discount {
  id          String       @id @default(uuid())
  productId   String
  discountType DiscountType
  value       Float        // Percentage (0-100) or fixed amount
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Relations
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@index([discountType])
  
  // Unique constraint for product + discount type combination
  @@unique([productId, discountType])
}

// Security: Image model with validation
model Image {
  id        String   @id @default(uuid())
  image     String   @db.VarChar(500) // Limit URL length
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  // Performance: Add index for product queries
  @@index([productId])
  @@index([id])
}

// Security: Cart item model with validation and unit support
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  unitId    String   // Selected unit for this cart item
  unitPrice Float    // Price per unit at time of adding to cart
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id])
  
  // Performance: Add indexes
  @@index([userId])
  @@index([productId])
  @@index([userId, productId])
  @@index([createdAt])
}

// Security: Enhanced User model with better validation
model User {
  id                             String    @id @default(cuid())
  email                          String    @unique @db.VarChar(255)
  username                       String?   @db.VarChar(100) // Display name for better UX
  firstName                      String?   @db.VarChar(100)
  lastName                       String?   @db.VarChar(100)
  gender                         Gender?   // For personalized UI
  profilePicture                 String?   @db.VarChar(500) // URL to profile image
  password                       String    @db.VarChar(255)
  emailVerified                  Boolean   @default(false)
  emailVerificationToken         String?   @unique @db.VarChar(255)
  emailVerificationTokenExpires  DateTime?
  twoFactorEnabled               Boolean   @default(false)
  twoFactorSecret                String?   @db.VarChar(255)
  refreshToken                   String?   @unique @db.VarChar(255)
  passwordResetToken             String?   @unique @db.VarChar(255)
  passwordResetTokenExpires      DateTime?
  role                           UserRole  @default(USER)
  canLogin                       Boolean   @default(true)
  disabled                       Boolean   @default(false)
  lastLoginAt                    DateTime?
  loginAttempts                  Int       @default(0)
  lockedUntil                    DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  
  // Relations
  sessions       Session[]
  auditLogs      AuditLog[]
  recoveryCodes  RecoveryCode[]
  articles       Article[]
  
  // Performance: Add indexes for common queries
  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

// Security: Blacklisted token model for JWT token revocation
model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  // Performance: Add indexes for cleanup queries
  @@index([expiresAt])
  @@index([token])
}

// Security: Recovery codes model
model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(255)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes
  @@index([userId])
  @@index([createdAt])
}

// Security: Session model with better tracking
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique @db.VarChar(255)
  userAgent    String?  @db.VarChar(500)
  ip           String?  @db.VarChar(45) // IPv6 compatible
  deviceFingerprint String? @db.VarChar(64) // SHA256 hash of device fingerprint
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deviceFingerprint])
}

// Security: Audit log model with better structure
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Performance: Add indexes for common queries
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
}

// Security: Article model with proper validation and relations
model Article {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  imageUrl  String?  @db.VarChar(500)
  summary   String   @db.VarChar(500)
  content   String   @db.Text
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Performance: Add indexes for common queries
  @@index([slug])
  @@index([authorId])
  @@index([createdAt])
  @@index([title])
  @@index([status])
}