  boxTextureUrl   String?
  crownLogoUrl    String?
  unlockSoundUrl  String?
  openSoundUrl    String?
  sparkleSoundUrl String?
  unwrapSoundUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LuxuryUnboxingSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id             String       @id @default(cuid())
  productId      String
  userId         String?
  userName       String
  rating         Int          @default(5)
  title          String?      @db.VarChar(255)
  comment        String       @db.Text
  pros           String[]     @default([])
  cons           String[]     @default([])
  images         String[]     @default([])
  videos         String[]     @default([])
  status         ReviewStatus @default(PENDING)
  isVerified     Boolean      @default(false)
  isFeatured     Boolean      @default(false)
  helpfulCount   Int          @default(0)
  helpfulUserIds String[]     @default([])
  reply          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Video {
  id           String   @id @default(cuid())
  url          String   @db.VarChar(500)
  thumbnailUrl String?  @db.VarChar(500)
  productId    String
  sortOrder    Int      @default(0)
  isFeatured   Boolean  @default(false)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model MarketingShowcaseSlide {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  imageUrl      String   @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  productId     String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([sortOrder])
}
