generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String          @id @default(uuid())
  name         String          @unique @db.VarChar(255)
  category     ProductCategory
  description  String?
  basePrice    Float           @default(0.0)
  baseUnitId   String
  quantity     Int             @default(0)
  status       ProductStatus   @default(ACTIVE)
  isNew        Boolean         @default(false)
  isBestSeller Boolean         @default(false)
  isAmazing    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cartItems    CartItem[]
  discounts    Discount[]
  images       Image[]
  baseUnit     Unit            @relation(fields: [baseUnitId], references: [id])
  units        ProductUnit[]
  analytics    ProductAnalytics?

  @@index([category])
  @@index([basePrice])
  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@index([category, status])
  @@index([basePrice, status])
  @@index([isNew])
  @@index([isBestSeller])
  @@index([isAmazing])
}

model Unit {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(50)
  symbol     String     @unique @db.VarChar(10)
  multiplier Float      @default(1.0)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  cartItems  CartItem[]
  products   Product[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

model ProductUnit {
  id        String   @id @default(cuid())
  productId String
  name      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([stock])
  @@index([createdAt])
}

model Discount {
  id           String       @id @default(uuid())
  productId    String
  discountType DiscountType
  value        Float
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, discountType])
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@index([discountType])
}

model Image {
  id        String   @id @default(uuid())
  image     String   @db.VarChar(500)
  productId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([id])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  unitId    String
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([userId, productId])
  @@index([createdAt])
}

model User {
  id                            String              @id @default(cuid())
  email                         String              @unique @db.VarChar(255)
  username                      String?             @unique @db.VarChar(100)
  firstName                     String?             @db.VarChar(100)
  lastName                      String?             @db.VarChar(100)
  gender                        Gender?
  profilePicture                String?             @db.VarChar(500)
  password                      String              @db.VarChar(255)
  emailVerified                 Boolean             @default(false)
  emailVerificationToken        String?             @unique @db.VarChar(255)
  emailVerificationTokenExpires DateTime?
  twoFactorEnabled              Boolean             @default(false)
  twoFactorSecret               String?             @db.VarChar(255)
  refreshToken                  String?             @unique @db.VarChar(255)
  passwordResetToken            String?             @unique @db.VarChar(255)
  passwordResetTokenExpires     DateTime?
  role                          UserRole            @default(USER)
  canLogin                      Boolean             @default(true)
  disabled                      Boolean             @default(false)
  lastLoginAt                   DateTime?
  loginAttempts                 Int                 @default(0)
  lockedUntil                   DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  articles                      Article[]
  auditLogs                     AuditLog[]
  comments                      Comment[]
  emailVerifications            EmailVerification[]
  recoveryCodes                 RecoveryCode[]
  sessions                      Session[]
  analyticsEvents               AnalyticsEvent[]
  userAnalytics                 UserAnalytics?
  chatMessages                  ChatMessage[]
  userProfile                   UserProfile?
  rewards                       Reward[]
  leaderboardEntry              LeaderboardEntry?
  socialShares                  SocialShare[]
  wishlistCompetitions          WishlistCompetition[]
  arSessions                    ARSession[]
  vrStoreVisits                 VRStoreVisit[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([token])
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(255)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String   @db.VarChar(255)
  codeHash  String   @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdAt])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshToken      String   @unique @db.VarChar(255)
  userAgent         String?  @db.VarChar(500)
  ip                String?  @db.VarChar(45)
  deviceFingerprint String?  @db.VarChar(64)
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  lastUsedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deviceFingerprint])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
}

model Article {
  id        String        @id @default(uuid())
  title     String        @db.VarChar(255)
  slug      String        @unique @db.VarChar(255)
  imageUrl  String?       @db.VarChar(500)
  summary   String        @db.VarChar(500)
  content   String
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  authorId  String
  category  String?       @db.VarChar(100)
  tags      String[]      @default([])
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([slug])
  @@index([authorId])
  @@index([createdAt])
  @@index([title])
  @@index([status])
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articleId String
  authorId  String?
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id])

  @@index([articleId])
  @@index([authorId])
  @@index([createdAt])
  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  EDITOR
  MODERATOR
  SUPERADMIN
  SYSTEM
  AUTHOR
}

enum ProductCategory {
  HONEY
  SAFFRON
  DATES
  OTHERS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String   @db.VarChar(255)
  eventType   String   @db.VarChar(50)
  productId   String?
  categoryId  String?
  unitId      String?
  quantity    Int?
  price       Float?
  searchQuery String?
  pageUrl     String   @db.VarChar(500)
  timestamp   DateTime @default(now())
  metadata    Json?
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([productId])
  @@index([timestamp])
}

model ProductAnalytics {
  id          String   @id @default(cuid())
  productId   String
  viewCount   Int      @default(0)
  clickCount  Int      @default(0)
  addToCartCount Int   @default(0)
  purchaseCount Int    @default(0)
  revenue     Float    @default(0.0)
  totalRevenue Float   @default(0.0)
  lastViewed  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId])
  @@index([productId])
  @@index([viewCount])
  @@index([revenue])
}

model UserAnalytics {
  id           String   @id @default(cuid())
  userId       String
  totalViews   Int      @default(0)
  totalClicks  Int      @default(0)
  totalPurchases Int    @default(0)
  totalSpent   Float    @default(0.0)
  totalAddToCart Int    @default(0)
  lastActivity DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@index([totalViews])
  @@index([totalSpent])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String   @db.VarChar(255)
  content   String
  type      String   @db.VarChar(20) // 'user' or 'assistant'
  timestamp DateTime @default(now())
  metadata  Json?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  level            Int      @default(1)
  experience       Int      @default(0)
  experiencePoints Int      @default(0)
  badges           String[] @default([])
  achievements     String[] @default([])
  totalSpent       Float    @default(0.0)
  totalOrders      Int      @default(0)
  loginStreak      Int      @default(0)
  lastLoginDate    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([level])
  @@index([experience])
}

model Reward {
  id          String     @id @default(cuid())
  userId      String
  type        RewardType
  title       String     @db.VarChar(255)
  value       Float
  description String?
  isRedeemed  Boolean    @default(false)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRedeemed])
  @@index([expiresAt])
}

model LeaderboardEntry {
  id           String   @id @default(cuid())
  userId       String   @unique
  score        Int      @default(0)
  rank         Int?
  category     String   @default("overall") @db.VarChar(50)
  period       String   @default("all") @db.VarChar(20)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, period])
  @@index([userId])
  @@index([score])
  @@index([rank])
  @@index([category])
  @@index([period])
}

model SocialShare {
  id        String   @id @default(cuid())
  userId    String?
  platform  String   @db.VarChar(50)
  content   String
  url       String?  @db.VarChar(500)
  shareUrl  String?  @db.VarChar(500)
  productId String?
  clicks    Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([platform])
  @@index([productId])
  @@index([createdAt])
}

model LiveEvent {
  id                String   @id @default(cuid())
  title             String   @db.VarChar(255)
  description       String?
  eventType         String   @default("live") @db.VarChar(50)
  startTime         DateTime
  endTime           DateTime?
  maxParticipants   Int      @default(100)
  currentParticipants Int    @default(0)
  isActive          Boolean  @default(true)
  meetingUrl        String?  @db.VarChar(500)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([startTime])
  @@index([isActive])
  @@index([eventType])
  @@index([createdAt])
}

model WishlistCompetition {
  id            String    @id @default(cuid())
  title         String    @db.VarChar(255)
  description   String?
  userId        String?
  productId     String?
  score         Int       @default(0)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isActive      Boolean   @default(true)
  participants  Int       @default(0)
  winnerId      String?
  rewardValue   Float     @default(0.0)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([score])
  @@index([isActive])
  @@index([createdAt])
}

model ARSession {
  id         String   @id @default(cuid())
  userId     String?
  productId  String?
  duration   Int      @default(0)
  sessionType String  @default("PRODUCT_PREVIEW") @db.VarChar(50)
  deviceType String?  @db.VarChar(50)
  endedAt    DateTime?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([sessionType])
  @@index([createdAt])
}

model VRStoreVisit {
  id        String    @id @default(cuid())
  userId    String?
  duration  Int       @default(0)
  endedAt   DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

enum RewardType {
  DISCOUNT_COUPON
  FREE_SHIPPING
  POINTS_BONUS
  EXCLUSIVE_ACCESS
  BADGE
  ACHIEVEMENT
}
