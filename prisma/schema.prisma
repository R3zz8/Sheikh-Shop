generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String              @id @default(uuid())
  name           String              @unique @db.VarChar(255)
  category       ProductCategory
  description    String?
  basePrice      Float               @default(0.0)
  baseUnitId     String
  quantity       Int                 @default(0)
  status         ProductStatus       @default(ACTIVE)
  isNew          Boolean             @default(false)
  isBestSeller   Boolean             @default(false)
  isAmazing      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  categoryId     String?
  categoryType   ProductCategoryType @default(SheikhFood)
  slug           String?             @db.VarChar(255)
  seoTitle       String?             @db.VarChar(60)
  seoDescription String?             @db.VarChar(160)
  metaKeywords   String[]            @default([])
  canonicalUrl   String?             @db.VarChar(500)
  ogImage        String?             @db.VarChar(500)
  h1Override     String?             @db.VarChar(100)
  excerpt        String?
  ogTitle        String?             @db.VarChar(60)
  ogDescription  String?             @db.VarChar(160)
  schemaMarkup   Json?
  brand          String?             @db.VarChar(100)
  sku            String?             @db.VarChar(100)
  features       String[]            @default([])
  technicalSpecs Json?
  tags           String[]            @default([])
  weight         Float?
  weightUnit     String?             @default("kg") @db.VarChar(10)
  dimensions     Json?
  materials      String[]            @default([])
  warranty       String?             @db.VarChar(200)
  origin         String?             @db.VarChar(100)
  color          String?             @db.VarChar(50)
  scent          String?             @db.VarChar(50)
  flavor         String?             @db.VarChar(50)
  shippingCost        Float?
  shippingMode        String?
  shippingDescription String?
  allowFreeShipping   Boolean?        @default(false)
  shippingPriority    String?
  cartItems      CartItem[]
  discounts      Discount[]
  images         Image[]
  baseUnit       Unit                @relation(fields: [baseUnitId], references: [id])
  Category       Category?           @relation(fields: [categoryId], references: [id])
  units          ProductUnit[]
  reviews        Review[]
  videos         Video[]
  productAttributes ProductAttribute[]
  marketingShowcaseSlides MarketingShowcaseSlide[]

  @@index([category])
  @@index([basePrice])
  @@index([status])
  @@index([createdAt])
  @@index([isNew])
  @@index([isBestSeller])
  @@index([isAmazing])
  @@index([basePrice, status], map: "idx_product_baseprice_status_unique")
  @@index([category, status], map: "idx_product_category_status_unique")
  @@index([name], map: "idx_product_name_unique")
  @@index([categoryId])
  @@index([slug])
  @@index([categoryType])
  @@index([categoryType, status])
  @@index([slug, status])
  @@index([name, status], map: "idx_product_name_status")
  @@index([tags], map: "idx_product_tags_gin", type: Gin)
  @@index([features], map: "idx_product_features_gin", type: Gin)
  @@index([materials], map: "idx_product_materials_gin", type: Gin)
}

model Unit {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(50)
  symbol     String     @unique @db.VarChar(10)
  multiplier Float      @default(1.0)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  cartItems  CartItem[]
  products   Product[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

model WebService {
  id                String              @id @default(cuid())
  title             String              @db.VarChar(255)
  slug              String              @unique @db.VarChar(255)
  shortDescription  String              @db.VarChar(500)
  fullDescription   String?             @db.Text
  startingPrice     Int                 @default(0)
  previousPrice     Int?
  currency          String              @default("تومان") @db.VarChar(20)
  isStartingFrom    Boolean             @default(true)
  features          String[]            @default([])
  estimatedDelivery String?             @db.VarChar(100)
  imageUrl          String?             @db.VarChar(500)
  imagePublicId     String?             @db.VarChar(255)
  icon              String?             @db.VarChar(100)
  displayOrder      Int                 @default(0)
  isActive          Boolean             @default(true)
  isFeatured        Boolean             @default(false)
  ctaText           String?             @default("مشاهده و سفارش") @db.VarChar(100)
  ctaUrl            String?             @db.VarChar(500)
  seoTitle          String?             @db.VarChar(100)
  seoDescription    String?             @db.VarChar(255)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  packages          WebServicePackage[]
  leads             WebLead[]

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@index([isFeatured])
}

model WebServicePackage {
  id           String     @id @default(cuid())
  serviceId    String
  name         String     @db.VarChar(100)
  price        Int        @default(0)
  oldPrice     Int?
  description  String?    @db.VarChar(500)
  features     String[]   @default([])
  badge        String?    @db.VarChar(50)
  isPopular    Boolean    @default(false)
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  service      WebService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([isActive])
  @@index([displayOrder])
}

model WebPortfolio {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  imageUrl      String   @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  technologies  String[] @default([])
  projectUrl    String?  @db.VarChar(500)
  category      String?  @db.VarChar(100)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@index([category])
}

model WebFaq {
  id           String   @id @default(cuid())
  question     String   @db.VarChar(500)
  answer       String   @db.Text
  category     String?  @db.VarChar(100)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}

model WebCalculatorRule {
  id           String   @id @default(cuid())
  title        String   @db.VarChar(255)
  key          String   @unique @db.VarChar(100)
  category     String   @db.VarChar(50)
  price        Int      @default(0)
  icon         String?  @db.VarChar(100)
  isDefault    Boolean  @default(false)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([key])
  @@index([category])
  @@index([isActive])
  @@index([displayOrder])
}

model WebLead {
  id               String      @id @default(cuid())
  serviceId        String?
  name             String      @db.VarChar(100)
  phone            String      @db.VarChar(20)
  siteType         String      @db.VarChar(100)
  selectedFeatures String[]    @default([])
  estimatedPrice   Int         @default(0)
  notes            String?     @db.Text
  status           String      @default("PENDING") @db.VarChar(50)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  service          WebService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
}

model WebDesignShowcase {
  id            String   @id @default(cuid())
  title         String   @default("شیخ وب؛ جایی که ایده‌ها تبدیل به وب‌سایت می‌شوند.") @db.VarChar(255)
  description   String   @default("طراحی و توسعه وب‌سایت‌های فروشگاهی، شرکتی، خدماتی و اختصاصی با تکنولوژی‌های مدرن، طراحی حرفه‌ای و تمرکز بر سرعت و تجربه کاربری.") @db.Text
  services      String[] @default(["فروشگاهی", "شرکتی", "خدماتی", "شخصی", "اختصاصی"])
  imageUrl      String?  @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  ctaText       String?  @default("مشاهده خدمات طراحی سایت") @db.VarChar(100)
  ctaUrl        String?  @default("/services/web-design") @db.VarChar(500)
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isEnabled])
}

model BmwCarouselItem {
  id            String   @id @default(cuid())
  title         String?  @db.VarChar(255)
  imageUrl      String   @db.VarChar(500)
  imagePublicId String?  @db.VarChar(255)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ProductUnit {
  id        String             @id @default(cuid())
  productId String
  name      String             @db.VarChar(100)
  price     Decimal            @db.Decimal(10, 2)
  oldPrice  Decimal?           @db.Decimal(10, 2)
  sku       String?            @db.VarChar(100)
  stock     Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductUnitValue[]

  @@index([productId])
  @@index([isActive])
  @@index([stock])
  @@index([createdAt])
}

model Attribute {
  id                String             @id @default(uuid())
  name              String             @db.VarChar(100)
  displayName       String             @db.VarChar(100)
  type              String             @db.VarChar(50)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  values            AttributeValue[]
  productAttributes ProductAttribute[]
}

model AttributeValue {
  id                String             @id @default(uuid())
  attributeId       String
  value             String             @db.VarChar(100)
  unit              String?            @db.VarChar(50)
  hex               String?            @db.VarChar(50)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productUnitValues ProductUnitValue[]

  @@index([attributeId])
}

model ProductAttribute {
  id          String    @id @default(uuid())
  productId   String
  attributeId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
}

model ProductUnitValue {
  productUnitId    String
  attributeValueId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  productUnit      ProductUnit    @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productUnitId, attributeValueId])
  @@index([productUnitId])
  @@index([attributeValueId])
}

model Discount {
  id           String       @id @default(uuid())
  productId    String
  discountType DiscountType
  value        Float
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, discountType])
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@index([discountType])
}

model Image {
  id        String   @id @default(uuid())
  image     String?  @db.VarChar(500)
  productId String?
  createdAt DateTime @default(now())
  bytes     Int?
  format    String?  @db.VarChar(20)
  height    Int?
  publicId  String?  @db.VarChar(255)
  secureUrl String?  @db.VarChar(500)
  width     Int?
  sortOrder  Int      @default(0)
  isFeatured Boolean  @default(false)
  isVisible  Boolean  @default(true)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([publicId])
  @@index([sortOrder])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  unitId    String
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([userId, productId])
  @@index([createdAt])
}

model User {
  id                            String              @id @default(cuid())
  email                         String              @unique @db.VarChar(255)
  username                      String?             @unique @db.VarChar(100)
  firstName                     String?             @db.VarChar(100)
  lastName                      String?             @db.VarChar(100)
  gender                        Gender?
  profilePicture                String?             @db.VarChar(500)
  password                      String              @db.VarChar(255)
  emailVerified                 Boolean             @default(false)
  provider                      String              @default("EMAIL") @db.VarChar(50)
  emailVerificationToken        String?             @unique @db.VarChar(255)
  emailVerificationTokenExpires DateTime?
  twoFactorEnabled              Boolean             @default(false)
  twoFactorSecret               String?             @db.VarChar(255)
  refreshToken                  String?             @unique @db.VarChar(255)
  passwordResetToken            String?             @unique @db.VarChar(255)
  passwordResetTokenExpires     DateTime?
  role                          UserRole            @default(USER)
  canLogin                      Boolean             @default(true)
  disabled                      Boolean             @default(false)
  lastLoginAt                   DateTime?
  loginAttempts                 Int                 @default(0)
  lockedUntil                   DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  affiliate                     Affiliate?
  articles                      Article[]
  auditLogs                     AuditLog[]
  comments                      Comment[]
  emailVerifications            EmailVerification[]
  orders                        Order[]
  recoveryCodes                 RecoveryCode[]
  sessions                      Session[]
  likes                         UserLike[]
  reviews                       Review[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([token])
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(255)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String   @db.VarChar(255)
  codeHash  String   @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdAt])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshToken      String   @unique @db.VarChar(255)
  userAgent         String?  @db.VarChar(500)
  ip                String?  @db.VarChar(45)
  deviceFingerprint String?  @db.VarChar(64)
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  lastUsedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deviceFingerprint])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
}

model Article {
  id               String           @id @default(uuid())
  title            String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  imageUrl         String?          @db.VarChar(500)
  summary          String           @db.VarChar(500)
  content          String
  status           ArticleStatus    @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  authorId         String
  category         String?          @db.VarChar(100)
  tags             String[]         @default([])
  excerpt          String?          @db.VarChar(300)
  externalLinks    String[]         @default([])
  internalLinks    String[]         @default([])
  keywords         String[]         @default([])
  metaDescription  String?          @db.VarChar(155)
  metaTitle        String?          @db.VarChar(60)
  publishedAt      DateTime?
  readTime         Int?
  schemaMarkup     Json?
  analytics        Json?
  language         String           @default("en") @db.VarChar(5)
  likes            Int              @default(0)
  previousVersions Json?
  shares           Int              @default(0)
  version          Int              @default(1)
  views            Int              @default(0)
  column_1         String?
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions         ArticleVersion[]
  comments         Comment[]
  userLikes        UserLike[]

  @@index([slug])
  @@index([authorId])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([title])
  @@index([status])
  @@index([category])
  @@index([metaTitle])
  @@index([keywords])
  @@index([views])
  @@index([language])
  @@index([views, language])
  @@index([status, views])
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articleId String
  authorId  String?
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id])

  @@index([articleId])
  @@index([authorId])
  @@index([createdAt])
  @@index([status])
}

model ArticleVersion {
  id              String   @id @default(cuid())
  articleId       String
  version         Int
  content         String
  metaTitle       String?  @db.VarChar(60)
  metaDescription String?  @db.VarChar(155)
  title           String?  @db.VarChar(255)
  summary         String?  @db.VarChar(500)
  keywords        String[] @default([])
  updatedAt       DateTime @updatedAt
  createdBy       String
  changes         Json?
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId])
  @@index([version])
  @@index([createdBy])
  @@index([updatedAt])
}

model UserLike {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([createdAt])
}

model Affiliate {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  referralCode     String                 @unique
  totalClicks      Int                    @default(0)
  totalSales       Int                    @default(0)
  commissionEarned Decimal                @default(0) @db.Decimal(10, 2)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyStats       AffiliateDailyStat[]
  transactions     AffiliateTransaction[]
  referrals        Referral[]

  @@index([userId])
  @@index([referralCode])
}

model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  ipAddress   String?
  userAgent   String?
  isConverted Boolean   @default(false)
  orderId     String?   @unique
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id])

  @@index([affiliateId])
  @@index([orderId])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  total           Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @default(0.00) @db.Decimal(10, 2)
  shippingCost    Decimal       @default(200000.00) @db.Decimal(10, 2)
  discount        Decimal       @default(0.00) @db.Decimal(10, 2)
  totalPrice      Decimal       @default(0.00) @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  shippingAddress Json?
  trackingCode    String?       @db.VarChar(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  referral        Referral?
  transactions    Transaction[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  productName  String?  @db.VarChar(255)
  productImage String?  @db.VarChar(500)
  unitName     String?  @db.VarChar(100)
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  shippingCost Decimal? @db.Decimal(10, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model AffiliateDailyStat {
  id               String    @id @default(cuid())
  affiliateId      String
  date             DateTime  @db.Date
  clicks           Int       @default(0)
  sales            Int       @default(0)
  commissionEarned Decimal   @default(0) @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, date])
  @@index([affiliateId])
  @@index([date])
}

model AffiliateTransaction {
  id             String    @id @default(cuid())
  affiliateId    String
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @default("PENDING")
  paymentGateway String?   @db.VarChar(50)
  transactionId  String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id          String   @id @default(cuid())
  authority   String   @unique
  reference   String?
  amount      Int
  status      String
  description String?
  orderId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([reference])
  @@index([orderId])
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique @db.VarChar(100)
  slug          String    @unique @db.VarChar(100)
  createdAt     DateTime  @default(now())
  description   String?   @db.VarChar(500)
  image         String?   @db.VarChar(500)
  imagePublicId String?   @db.VarChar(255)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([name])
}

model MobileCarousel {
  id        String   @id @default(cuid())
  topTitle  String?  @default("فروشگاه شیخ")
  subtitle  String?  @default("international store")
  title     String
  ctaText   String?  @default("مشاهده فروشگاه")
  image     String
  link      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

