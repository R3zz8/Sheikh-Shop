generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String              @id @default(uuid())
  name           String              @unique @db.VarChar(255)
  category       ProductCategory
  description    String?
  basePrice      Float               @default(0.0)
  baseUnitId     String
  quantity       Int                 @default(0)
  status         ProductStatus       @default(ACTIVE)
  isNew          Boolean             @default(false)
  isBestSeller   Boolean             @default(false)
  isAmazing      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  categoryId     String?
  categoryType   ProductCategoryType @default(SheikhFood)
  slug           String?             @db.VarChar(255)
  seoTitle       String?             @db.VarChar(60)
  seoDescription String?             @db.VarChar(160)
  metaKeywords   String[]            @default([])
  canonicalUrl   String?             @db.VarChar(500)
  ogImage        String?             @db.VarChar(500)
  h1Override     String?             @db.VarChar(100)
  excerpt        String?
  ogTitle        String?             @db.VarChar(60)
  ogDescription  String?             @db.VarChar(160)
  schemaMarkup   Json?
  brand          String?             @db.VarChar(100)
  sku            String?             @db.VarChar(100)
  features       String[]            @default([])
  technicalSpecs Json?
  tags           String[]            @default([])
  weight         Float?
  weightUnit     String?             @default("kg") @db.VarChar(10)
  dimensions     Json?
  materials      String[]            @default([])
  warranty       String?             @db.VarChar(200)
  origin         String?             @db.VarChar(100)
  color          String?             @db.VarChar(50)
  scent          String?             @db.VarChar(50)
  flavor         String?             @db.VarChar(50)
  shippingCost        Float?
  shippingMode        String?
  shippingDescription String?
  allowFreeShipping   Boolean?        @default(false)
  shippingPriority    String?
  cartItems      CartItem[]
  discounts      Discount[]
  images         Image[]
  baseUnit       Unit                @relation(fields: [baseUnitId], references: [id])
  Category       Category?           @relation(fields: [categoryId], references: [id])
  units          ProductUnit[]
  reviews        Review[]
  videos         Video[]

  @@index([category])
  @@index([basePrice])
  @@index([status])
  @@index([createdAt])
  @@index([isNew])
  @@index([isBestSeller])
  @@index([isAmazing])
  @@index([basePrice, status], map: "idx_product_baseprice_status_unique")
  @@index([category, status], map: "idx_product_category_status_unique")
  @@index([name], map: "idx_product_name_unique")
  @@index([categoryId])
  @@index([slug])
  @@index([name, status], map: "idx_product_name_status")
  @@index([tags], map: "idx_product_tags_gin", type: Gin)
  @@index([features], map: "idx_product_features_gin", type: Gin)
  @@index([materials], map: "idx_product_materials_gin", type: Gin)
}

model Unit {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(50)
  symbol     String     @unique @db.VarChar(10)
  multiplier Float      @default(1.0)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  cartItems  CartItem[]
  products   Product[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

model ProductUnit {
  id        String   @id @default(cuid())
  productId String
  name      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([stock])
  @@index([createdAt])
}

model Discount {
  id           String       @id @default(uuid())
  productId    String
  discountType DiscountType
  value        Float
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, discountType])
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@index([discountType])
}

model Image {
  id        String   @id @default(uuid())
  image     String?  @db.VarChar(500)
  productId String?
  createdAt DateTime @default(now())
  bytes     Int?
  format    String?  @db.VarChar(20)
  height    Int?
  publicId  String?  @db.VarChar(255)
  secureUrl String?  @db.VarChar(500)
  width     Int?
  sortOrder  Int      @default(0)
  isFeatured Boolean  @default(false)
  isVisible  Boolean  @default(true)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([publicId])
  @@index([sortOrder])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  unitId    String
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([userId, productId])
  @@index([createdAt])
}

model User {
  id                            String              @id @default(cuid())
  email                         String              @unique @db.VarChar(255)
  username                      String?             @unique @db.VarChar(100)
  firstName                     String?             @db.VarChar(100)
  lastName                      String?             @db.VarChar(100)
  gender                        Gender?
  profilePicture                String?             @db.VarChar(500)
  password                      String              @db.VarChar(255)
  emailVerified                 Boolean             @default(false)
  provider                      String              @default("EMAIL") @db.VarChar(50)
  emailVerificationToken        String?             @unique @db.VarChar(255)
  emailVerificationTokenExpires DateTime?
  twoFactorEnabled              Boolean             @default(false)
  twoFactorSecret               String?             @db.VarChar(255)
  refreshToken                  String?             @unique @db.VarChar(255)
  passwordResetToken            String?             @unique @db.VarChar(255)
  passwordResetTokenExpires     DateTime?
  role                          UserRole            @default(USER)
  canLogin                      Boolean             @default(true)
  disabled                      Boolean             @default(false)
  lastLoginAt                   DateTime?
  loginAttempts                 Int                 @default(0)
  lockedUntil                   DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  affiliate                     Affiliate?
  articles                      Article[]
  auditLogs                     AuditLog[]
  comments                      Comment[]
  emailVerifications            EmailVerification[]
  orders                        Order[]
  recoveryCodes                 RecoveryCode[]
  sessions                      Session[]
  likes                         UserLike[]
  reviews                       Review[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([token])
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(255)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String   @db.VarChar(255)
  codeHash  String   @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdAt])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshToken      String   @unique @db.VarChar(255)
  userAgent         String?  @db.VarChar(500)
  ip                String?  @db.VarChar(45)
  deviceFingerprint String?  @db.VarChar(64)
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  lastUsedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deviceFingerprint])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
}

model Article {
  id               String           @id @default(uuid())
  title            String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  imageUrl         String?          @db.VarChar(500)
  summary          String           @db.VarChar(500)
  content          String
  status           ArticleStatus    @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  authorId         String
  category         String?          @db.VarChar(100)
  tags             String[]         @default([])
  excerpt          String?          @db.VarChar(300)
  externalLinks    String[]         @default([])
  internalLinks    String[]         @default([])
  keywords         String[]         @default([])
  metaDescription  String?          @db.VarChar(155)
  metaTitle        String?          @db.VarChar(60)
  publishedAt      DateTime?
  readTime         Int?
  schemaMarkup     Json?
  analytics        Json?
  language         String           @default("en") @db.VarChar(5)
  likes            Int              @default(0)
  previousVersions Json?
  shares           Int              @default(0)
  version          Int              @default(1)
  views            Int              @default(0)
  column_1         String?
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions         ArticleVersion[]
  comments         Comment[]
  userLikes        UserLike[]

  @@index([slug])
  @@index([authorId])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([title])
  @@index([status])
  @@index([category])
  @@index([metaTitle])
  @@index([keywords])
  @@index([views])
  @@index([language])
  @@index([views, language])
  @@index([status, views])
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articleId String
  authorId  String?
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id])

  @@index([articleId])
  @@index([authorId])
  @@index([createdAt])
  @@index([status])
}

model ArticleVersion {
  id              String   @id @default(cuid())
  articleId       String
  version         Int
  content         String
  metaTitle       String?  @db.VarChar(60)
  metaDescription String?  @db.VarChar(155)
  title           String?  @db.VarChar(255)
  summary         String?  @db.VarChar(500)
  keywords        String[] @default([])
  updatedAt       DateTime @updatedAt
  createdBy       String
  changes         Json?
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId])
  @@index([version])
  @@index([createdBy])
  @@index([updatedAt])
}

model UserLike {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([createdAt])
}

model Affiliate {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  referralCode     String                 @unique
  totalClicks      Int                    @default(0)
  totalSales       Int                    @default(0)
  commissionEarned Decimal                @default(0) @db.Decimal(10, 2)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyStats       AffiliateDailyStat[]
  transactions     AffiliateTransaction[]
  referrals        Referral[]

  @@index([userId])
  @@index([referralCode])
}

model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  ipAddress   String?
  userAgent   String?
  isConverted Boolean   @default(false)
  orderId     String?   @unique
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id])

  @@index([affiliateId])
  @@index([orderId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  total        Decimal     @db.Decimal(10, 2)
  shippingCost Decimal     @default(200000.00) @db.Decimal(10, 2)
  totalPrice   Decimal     @default(0.00) @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id])
  items        OrderItem[]
  referral     Referral?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  shippingCost Decimal? @db.Decimal(10, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model AffiliateDailyStat {
  id               String    @id @default(cuid())
  affiliateId      String
  date             DateTime  @db.Date
  clicks           Int       @default(0)
  sales            Int       @default(0)
  commissionEarned Decimal   @default(0) @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, date])
  @@index([affiliateId])
  @@index([date])
}

model AffiliateTransaction {
  id             String    @id @default(cuid())
  affiliateId    String
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @default("PENDING")
  paymentGateway String?   @db.VarChar(50)
  transactionId  String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id          String   @id @default(cuid())
  authority   String   @unique
  reference   String?
  amount      Int
  status      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([reference])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  createdAt   DateTime  @default(now())
  description String?   @db.VarChar(500)
  image       String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@index([name])
}

model MobileCarousel {
  id        String   @id @default(cuid())
  title     String
  image     String
  link      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum UserRole {
  USER
  ADMIN
  EDITOR
  MODERATOR
  SUPERADMIN
  SYSTEM
  AUTHOR
}

enum ProductCategory {
  HONEY
  SAFFRON
  DATES
  OTHERS
}

enum ProductCategoryType {
  SheikhFood
  SheikhTech
  SheikhDigital
  SheikhHome
  SheikhSmartLiving
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model ShowcaseConfig {
  id               String   @id @default(cuid())
  isEnabled        Boolean  @default(true)
  loopMode         Boolean  @default(true)
  autoplayInterval Int      @default(5000)
  animationSpeed   Int      @default(1000)
  backgroundGlow   String   @default("#fbbf24")
  maxProducts      Int      @default(6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FeaturedProduct {
  id             String   @id @default(cuid())
  productId      String
  order          Int      @default(0)
  badgeType      String   @default("BEST_SELLER")
  categoryEffect String   @default("SPEAKER")
  ctaText        String   @default("مشاهده محصول")
  ctaLink        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LuxuryUnboxingConfig {
  id                  String   @id @default(cuid())
  isEnabled           Boolean  @default(true)
  animationSpeed      Float    @default(1.0)
  particleDensity     Float    @default(1.0)
  lightIntensity      Float    @default(1.0)
  cameraDistance      Float    @default(5.0)
  enableAudio         Boolean  @default(true)
  ribbonColor         String   @default("#d97706") // Golden Amber amber-600
  goldenGlow          String   @default("#f59e0b") // Golden amber-500
  backgroundStyle     String   @default("dark-ambient") // dark-ambient, coffee, chocolate
  openingDuration     Float    @default(3.0) // seconds
  featuredProductMode String   @default("pedestal") // pedestal, 3d, floating
  autoPreview         Boolean  @default(false)
  introDuration       Float    @default(2.0)
  cameraSpeed         Float    @default(1.0)
  fogIntensity        Float    @default(1.0)
  audioVolume         Float    @default(0.5)
  animationPreset     String   @default("classic")
  autoClose           Boolean  @default(false)
  ctaStyle            String   @default("luxury")
  themePreset         String   @default("gold-chocolate")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model LuxuryUnboxingAssets {
  id              String   @id @default(cuid())
  boxTextureUrl   String?
  crownLogoUrl    String?
  unlockSoundUrl  String?
  openSoundUrl    String?
  sparkleSoundUrl String?
  unwrapSoundUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LuxuryUnboxingSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id             String       @id @default(cuid())
  productId      String
  userId         String?
  userName       String
  rating         Int          @default(5)
  title          String?      @db.VarChar(255)
  comment        String       @db.Text
  pros           String[]     @default([])
  cons           String[]     @default([])
  images         String[]     @default([])
  videos         String[]     @default([])
  status         ReviewStatus @default(PENDING)
  isVerified     Boolean      @default(false)
  isFeatured     Boolean      @default(false)
  helpfulCount   Int          @default(0)
  helpfulUserIds String[]     @default([])
  reply          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Video {
  id           String   @id @default(cuid())
  url          String   @db.VarChar(500)
  thumbnailUrl String?  @db.VarChar(500)
  productId    String
  sortOrder    Int      @default(0)
  isFeatured   Boolean  @default(false)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}
