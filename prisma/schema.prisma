generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String          @id @default(uuid())
  name         String          @unique @db.VarChar(255)
  category     ProductCategory
  description  String?
  basePrice    Float           @default(0.0)
  baseUnitId   String
  quantity     Int             @default(0)
  status       ProductStatus   @default(ACTIVE)
  isNew        Boolean         @default(false)
  isBestSeller Boolean         @default(false)
  isAmazing    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  cartItems    CartItem[]
  discounts    Discount[]
  images       Image[]
  baseUnit     Unit            @relation(fields: [baseUnitId], references: [id])
  units        ProductUnit[]
  arSessions   ARSession[]
  product3DModel Product3DModel?
  socialShares SocialShare[]

  @@index([category])
  @@index([basePrice])
  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@index([category, status])
  @@index([basePrice, status])
  @@index([isNew])
  @@index([isBestSeller])
  @@index([isAmazing])
}

model Unit {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(50)
  symbol     String     @unique @db.VarChar(10)
  multiplier Float      @default(1.0)
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  cartItems  CartItem[]
  products   Product[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

model ProductUnit {
  id        String   @id @default(cuid())
  productId String
  name      String   @db.VarChar(100)
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([stock])
  @@index([createdAt])
}

model Discount {
  id           String       @id @default(uuid())
  productId    String
  discountType DiscountType
  value        Float
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, discountType])
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
  @@index([discountType])
}

model Image {
  id        String   @id @default(uuid())
  image     String   @db.VarChar(500)
  productId String?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([id])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId String
  quantity  Int      @default(1)
  unitId    String
  unitPrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([userId, productId])
  @@index([createdAt])
}

model User {
  id                            String              @id @default(cuid())
  email                         String              @unique @db.VarChar(255)
  username                      String?             @unique @db.VarChar(100)
  firstName                     String?             @db.VarChar(100)
  lastName                      String?             @db.VarChar(100)
  gender                        Gender?
  profilePicture                String?             @db.VarChar(500)
  password                      String              @db.VarChar(255)
  emailVerified                 Boolean             @default(false)
  emailVerificationToken        String?             @unique @db.VarChar(255)
  emailVerificationTokenExpires DateTime?
  twoFactorEnabled              Boolean             @default(false)
  twoFactorSecret               String?             @db.VarChar(255)
  refreshToken                  String?             @unique @db.VarChar(255)
  passwordResetToken            String?             @unique @db.VarChar(255)
  passwordResetTokenExpires     DateTime?
  role                          UserRole            @default(USER)
  canLogin                      Boolean             @default(true)
  disabled                      Boolean             @default(false)
  lastLoginAt                   DateTime?
  loginAttempts                 Int                 @default(0)
  lockedUntil                   DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  articles                      Article[]
  auditLogs                     AuditLog[]
  comments                      Comment[]
  emailVerifications            EmailVerification[]
  recoveryCodes                 RecoveryCode[]
  sessions                      Session[]
  userProfile                   UserProfile?
  arSessions                    ARSession[]
  vrStoreVisits                 VRStoreVisit[]
  socialShares                  SocialShare[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([token])
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.VarChar(255)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String   @db.VarChar(255)
  codeHash  String   @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdAt])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  refreshToken      String   @unique @db.VarChar(255)
  userAgent         String?  @db.VarChar(500)
  ip                String?  @db.VarChar(45)
  deviceFingerprint String?  @db.VarChar(64)
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  lastUsedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deviceFingerprint])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(100)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ip])
}

model Article {
  id        String        @id @default(uuid())
  title     String        @db.VarChar(255)
  slug      String        @unique @db.VarChar(255)
  imageUrl  String?       @db.VarChar(500)
  summary   String        @db.VarChar(500)
  content   String
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  authorId  String
  category  String?       @db.VarChar(100)
  tags      String[]      @default([])
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([slug])
  @@index([authorId])
  @@index([createdAt])
  @@index([title])
  @@index([status])
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articleId String
  authorId  String?
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id])

  @@index([articleId])
  @@index([authorId])
  @@index([createdAt])
  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  EDITOR
  MODERATOR
  SUPERADMIN
  SYSTEM
  AUTHOR
}

enum ProductCategory {
  HONEY
  SAFFRON
  DATES
  OTHERS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Gamification Models
model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  level             Int      @default(1)
  experiencePoints  Int      @default(0)
  totalSpent        Float    @default(0.0)
  totalOrders       Int      @default(0)
  loginStreak       Int      @default(0)
  lastLoginDate     DateTime?
  achievements      String[] @default([])
  badges            String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards           Reward[]
  leaderboardEntries LeaderboardEntry[]

  @@index([level])
  @@index([experiencePoints])
  @@index([totalSpent])
  @@index([loginStreak])
}

model Reward {
  id          String      @id @default(cuid())
  userId      String
  type        RewardType
  title       String      @db.VarChar(255)
  description String?
  value       Float?
  code        String?     @unique @db.VarChar(50)
  isRedeemed  Boolean     @default(false)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRedeemed])
  @@index([expiresAt])
}

model LeaderboardEntry {
  id          String      @id @default(cuid())
  userId      String
  category    LeaderboardCategory
  score       Float
  rank        Int?
  period      LeaderboardPeriod @default(ALL_TIME)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, period])
  @@index([category])
  @@index([score])
  @@index([period])
  @@index([rank])
}

// AR/VR Models
model ARSession {
  id          String   @id @default(cuid())
  userId      String?
  productId   String?
  sessionType ARSessionType
  duration    Int      @default(0) // in seconds
  interactions Int     @default(0)
  deviceType  String?  @db.VarChar(50)
  userAgent   String?  @db.VarChar(500)
  ipAddress   String?  @db.VarChar(45)
  createdAt   DateTime @default(now())
  endedAt     DateTime?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([sessionType])
  @@index([createdAt])
}

model VRStoreVisit {
  id          String   @id @default(cuid())
  userId      String?
  duration    Int      @default(0) // in seconds
  categoriesVisited String[] @default([])
  productsViewed String[] @default([])
  interactions Int     @default(0)
  deviceType  String?  @db.VarChar(50)
  userAgent   String?  @db.VarChar(500)
  ipAddress   String?  @db.VarChar(45)
  createdAt   DateTime @default(now())
  endedAt     DateTime?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Product3DModel {
  id          String   @id @default(cuid())
  productId   String   @unique
  modelUrl    String   @db.VarChar(500)
  modelType   ModelType
  fileSize    Int?     // in bytes
  isOptimized Boolean  @default(false)
  isARReady   Boolean  @default(false)
  isVRReady   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([modelType])
  @@index([isARReady])
  @@index([isVRReady])
}

// Social & Engagement Models
model WishlistCompetition {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  rewardValue Float    @default(0.0)
  participants String[] @default([])
  winnerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
}

model SocialShare {
  id        String   @id @default(cuid())
  userId    String?
  productId String?
  platform  String   @db.VarChar(50) // facebook, twitter, instagram, etc.
  shareUrl  String   @db.VarChar(500)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([platform])
  @@index([createdAt])
}

model LiveEvent {
  id                String      @id @default(cuid())
  title             String      @db.VarChar(255)
  description       String
  eventType         LiveEventType
  startTime         DateTime
  endTime           DateTime
  maxParticipants   Int         @default(100)
  currentParticipants Int       @default(0)
  isActive          Boolean     @default(true)
  meetingUrl        String?     @db.VarChar(500)
  vrEnvironmentId   String?     @db.VarChar(100)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([eventType])
  @@index([startTime])
  @@index([endTime])
  @@index([isActive])
}

enum LiveEventType {
  VR_TASTING
  AR_DEMO
  LIVE_STREAM
  Q_AND_A
}

// Analytics Models
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String   @db.VarChar(100)
  eventData Json?
  timestamp DateTime @default(now())
  sessionId String?
  pageUrl   String?  @db.VarChar(500)
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(45)

  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@index([sessionId])
}

model ProductAnalytics {
  id          String   @id @default(cuid())
  productId   String
  views       Int      @default(0)
  clicks      Int      @default(0)
  addToCart   Int      @default(0)
  purchases   Int      @default(0)
  revenue     Float    @default(0.0)
  lastViewed  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId])
  @@index([productId])
  @@index([views])
  @@index([revenue])
}

model UserAnalytics {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalSessions   Int      @default(0)
  totalPageViews  Int      @default(0)
  totalTimeSpent  Int      @default(0) // in seconds
  lastActive      DateTime?
  favoriteCategory String? @db.VarChar(100)
  totalSpent      Float    @default(0.0)
  totalOrders     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([lastActive])
  @@index([totalSpent])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  message   String
  isBot     Boolean  @default(false)
  timestamp DateTime @default(now())
  metadata  Json?

  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
}

// Enums for new models
enum RewardType {
  DISCOUNT_COUPON
  FREE_SHIPPING
  POINTS_BONUS
  EXCLUSIVE_ACCESS
  BADGE
  ACHIEVEMENT
}

enum LeaderboardCategory {
  TOTAL_SPENT
  ORDERS_COUNT
  REVIEWS_COUNT
  LOGIN_STREAK
  AR_SESSIONS
  VR_VISITS
  SOCIAL_SHARES
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  ALL_TIME
}

enum ARSessionType {
  PRODUCT_PREVIEW
  TRY_ON
  ROOM_PLACEMENT
  QUICK_LOOK
}

enum ModelType {
  GLTF
  GLB
  OBJ
  FBX
  USDZ
}

// Update existing Product model
