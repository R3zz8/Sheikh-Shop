# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov

# next.js
/.next/
/out/
/dist

# production
/build

# misc
.DS_Store
*.pem
*.log
*.sqlite
*.local
*.DS_Store
.turbo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
/.clerk/.tmp/keyless.json

# prisma
prisma/dev.db
prisma/*.db
prisma/*.db-journal

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
.cache/

# Husky
.husky/

# Excalidraw files (design drafts)
*.excalidraw

# Local development files
*.local
